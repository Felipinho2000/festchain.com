{
  "name": "PilotTopup",
  "type": "object",
  "properties": {
    "amount": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "cancelled"
      ],
      "default": "confirmed"
    },
    "source": {
      "type": "string",
      "default": "pilot_beta"
    },
    "daily_count": {
      "type": "number",
      "default": 1
    },
    "balance_after": {
      "type": "number"
    }
  },
  "required": [
    "amount"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}