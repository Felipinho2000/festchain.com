{
  "name": "Ticket",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "event_title": {
      "type": "string"
    },
    "event_date": {
      "type": "string",
      "format": "date-time"
    },
    "event_image": {
      "type": "string"
    },
    "event_location": {
      "type": "string"
    },
    "organizer_id": {
      "type": "string"
    },
    "ticket_type": {
      "type": "string",
      "enum": [
        "general",
        "vip",
        "backstage"
      ],
      "default": "general"
    },
    "ticket_phase": {
      "type": "string"
    },
    "price_paid": {
      "type": "number"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "pix",
        "credit_card",
        "festcoin",
        "test"
      ],
      "default": "test"
    },
    "qr_code": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "used",
        "transferred",
        "expired",
        "refunded"
      ],
      "default": "active"
    },
    "checked_in": {
      "type": "boolean",
      "default": false
    },
    "checked_in_at": {
      "type": "string",
      "format": "date-time"
    },
    "scanned_at": {
      "type": "string",
      "format": "date-time"
    },
    "scanned_by": {
      "type": "string"
    },
    "festcoin_earned": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "event_id",
    "event_title",
    "price_paid",
    "payment_method"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.organizer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}