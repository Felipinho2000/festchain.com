{
  "name": "Ticket",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "event_title": {
      "type": "string"
    },
    "event_date": {
      "type": "string",
      "format": "date-time"
    },
    "event_image": {
      "type": "string"
    },
    "event_location": {
      "type": "string"
    },
    "organizer_id": {
      "type": "string"
    },
    "ticket_type": {
      "type": "string",
      "enum": [
        "general",
        "vip",
        "backstage"
      ],
      "default": "general"
    },
    "ticket_tier": {
      "type": "string",
      "enum": [
        "inteira",
        "meia_estudante",
        "meia_idoso"
      ],
      "default": "inteira"
    },
    "ticket_phase": {
      "type": "string"
    },
    "price_paid": {
      "type": "number"
    },
    "is_complimentary": {
      "type": "boolean",
      "default": false
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "pix",
        "credit_card",
        "festcoin",
        "test"
      ],
      "default": "test"
    },
    "qr_code": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "used",
        "transferred",
        "expired",
        "refunded"
      ],
      "default": "pending"
    },
    "checked_in": {
      "type": "boolean",
      "default": false
    },
    "checked_in_at": {
      "type": "string",
      "format": "date-time"
    },
    "scanned_at": {
      "type": "string",
      "format": "date-time"
    },
    "scanned_by": {
      "type": "string"
    },
    "festcoin_earned": {
      "type": "number",
      "default": 0
    },
    "stripe_session_id": {
      "type": "string"
    },
    "buyer_name": {
      "type": "string"
    },
    "buyer_cpf": {
      "type": "string"
    },
    "buyer_document_type": {
      "type": "string",
      "enum": [
        "cpf",
        "rg",
        "cnh"
      ],
      "default": "cpf"
    },
    "buyer_phone": {
      "type": "string"
    },
    "buyer_email": {
      "type": "string"
    },
    "fee_percentage_applied": {
      "type": "number",
      "description": "Snapshot of the rate at time of sale"
    },
    "platform_fee_cents": {
      "type": "number",
      "default": 0
    },
    "stripe_fee_cents": {
      "type": "number",
      "default": 0,
      "description": "Actual processing cost from the Stripe balance transaction"
    },
    "net_to_organizer_cents": {
      "type": "number",
      "default": 0
    },
    "fee_reversed": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "event_id",
    "event_title",
    "price_paid",
    "payment_method"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.status": "pending"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.organizer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}