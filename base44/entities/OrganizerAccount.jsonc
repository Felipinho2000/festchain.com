{
  "name": "OrganizerAccount",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Reference to the organizer user \u2014 unique"
    },
    "legal_name": {
      "type": "string"
    },
    "tax_id": {
      "type": "string",
      "description": "CPF or CNPJ"
    },
    "fee_percentage": {
      "type": "number",
      "default": 8.0,
      "description": "Standard rate. Admin-only \u2014 never settable from client."
    },
    "fee_tier": {
      "type": "string",
      "enum": [
        "pilot",
        "standard"
      ],
      "default": "standard"
    },
    "pilot_started_at": {
      "type": "string",
      "format": "date-time"
    },
    "pilot_expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "fee_paid_by": {
      "type": "string",
      "enum": [
        "organizer",
        "buyer"
      ],
      "default": "organizer"
    },
    "payout_pix_key": {
      "type": "string"
    },
    "payout_pix_key_type": {
      "type": "string",
      "enum": [
        "cpf",
        "cnpj",
        "email",
        "phone",
        "random"
      ]
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}