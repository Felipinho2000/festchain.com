{
  "name": "FestCoinTransaction",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "earned",
        "spent",
        "staked",
        "unstaked",
        "transferred_in",
        "transferred_out",
        "pilot_topup"
      ]
    },
    "amount": {
      "type": "number"
    },
    "description": {
      "type": "string"
    },
    "event_id": {
      "type": "string"
    },
    "event_title": {
      "type": "string"
    },
    "balance_after": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "confirmed",
        "pending",
        "cancelled",
        "failed"
      ],
      "default": "pending"
    },
    "source": {
      "type": "string"
    },
    "reference_id": {
      "type": "string"
    },
    "native_amount": {
      "type": "number"
    },
    "conversion_rate": {
      "type": "number"
    },
    "is_pilot": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "type",
    "amount",
    "description"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.status": "pending"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}