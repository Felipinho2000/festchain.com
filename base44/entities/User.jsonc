{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user",
        "attendee",
        "organizer",
        "staff",
        "guest"
      ],
      "default": "attendee"
    },
    "active_mode": {
      "type": "string",
      "description": "Current UI view preference: partygoer or organizer. Does NOT grant permissions.",
      "enum": [
        "partygoer",
        "organizer"
      ],
      "default": "partygoer"
    },
    "approved_organizer": {
      "type": "boolean",
      "description": "Granted manually by admin. Required (or role=admin) to access organizer dashboard & scanner.",
      "default": false
    },
    "organizer_profile": {
      "type": "object",
      "description": "One-time organizer onboarding profile",
      "properties": {
        "organizer_name": {
          "type": "string"
        },
        "brand_name": {
          "type": "string"
        },
        "instagram": {
          "type": "string"
        },
        "city": {
          "type": "string"
        }
      }
    }
  },
  "required": [
    "role"
  ]
}