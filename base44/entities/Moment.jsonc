{
  "name": "Moment",
  "type": "object",
  "properties": {
    "image_url": {
      "type": "string"
    },
    "caption": {
      "type": "string"
    },
    "event_id": {
      "type": "string"
    },
    "event_title": {
      "type": "string"
    },
    "is_anonymous": {
      "type": "boolean",
      "default": true
    },
    "author_alias": {
      "type": "string"
    },
    "likes": {
      "type": "number",
      "default": 0
    },
    "festcoin_tips": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "image_url"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}