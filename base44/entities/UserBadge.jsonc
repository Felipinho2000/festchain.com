{
  "name": "UserBadge",
  "type": "object",
  "properties": {
    "badge_key": {
      "type": "string",
      "description": "unique slug e.g. first_event, ten_events, night_owl"
    },
    "badge_name": {
      "type": "string"
    },
    "badge_description": {
      "type": "string"
    },
    "badge_emoji": {
      "type": "string"
    },
    "event_id": {
      "type": "string"
    },
    "event_title": {
      "type": "string"
    }
  },
  "required": [
    "badge_key",
    "badge_name",
    "badge_emoji"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}