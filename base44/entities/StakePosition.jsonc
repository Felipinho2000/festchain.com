{
  "name": "StakePosition",
  "type": "object",
  "properties": {
    "amount": {
      "type": "number"
    },
    "duration_days": {
      "type": "number"
    },
    "apy": {
      "type": "number"
    },
    "start_date": {
      "type": "string",
      "format": "date-time"
    },
    "end_date": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "completed",
        "unstaked"
      ],
      "default": "active"
    },
    "projected_yield": {
      "type": "number"
    },
    "earned_yield": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "amount",
    "duration_days",
    "apy",
    "start_date",
    "end_date"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}