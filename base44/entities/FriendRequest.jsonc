{
  "name": "FriendRequest",
  "type": "object",
  "properties": {
    "from_user_id": {
      "type": "string"
    },
    "from_alias": {
      "type": "string"
    },
    "to_user_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "declined"
      ],
      "default": "pending"
    },
    "message": {
      "type": "string"
    }
  },
  "required": [
    "from_user_id",
    "to_user_id",
    "status"
  ]
}