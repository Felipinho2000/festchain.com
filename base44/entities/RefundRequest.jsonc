{
  "name": "RefundRequest",
  "type": "object",
  "properties": {
    "ticket_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string",
      "description": "The attendee who requested the refund"
    },
    "user_name": {
      "type": "string"
    },
    "event_id": {
      "type": "string"
    },
    "event_title": {
      "type": "string"
    },
    "organizer_id": {
      "type": "string",
      "description": "Event owner \u2014 set server-side for RLS read access"
    },
    "reason": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "aprovado",
        "recusado"
      ],
      "default": "pendente"
    },
    "organizer_note": {
      "type": "string",
      "description": "Reason when declining"
    },
    "requested_at": {
      "type": "string",
      "format": "date-time"
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time"
    },
    "resolved_by_user_id": {
      "type": "string"
    }
  },
  "required": [
    "ticket_id",
    "user_id",
    "status"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.status": "pendente"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.organizer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.organizer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}